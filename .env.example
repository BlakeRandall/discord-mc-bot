
# Discord application
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Staff role: created automatically if it does not exist
STAFF_ROLE_NAME=Whitelist Staff

# Identifier expected by the existing whitelist service
SERVICE_UUID=

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=

# Optional MongoDB collection names
WHITELIST_COLLECTION=whitelist
REQUESTS_COLLECTION=whitelist_requests

# Optional: category for request channels
TICKET_CATEGORY_ID=

# Optional: delay before deleting completed request channels
CHANNEL_DELETE_DELAY_MINUTES=10

# UUID format used in the existing whitelist collection: dashed or undashed
UUID_FORMAT=dashed
